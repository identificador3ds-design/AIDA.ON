{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aida-on.vercel.app"
        }
      ],
      "destination": "https://aida-on.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "code"
        }
      ],
      "destination": "/pages/index-login",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "error"
        }
      ],
      "destination": "/pages/index-login",
      "permanent": false
    },
    {
      "source": "/index-:pagina",
      "destination": "/pages/index-:pagina",
      "permanent": false
    },
    {
      "source": "/solucao-:pagina",
      "destination": "/pages/solucao-:pagina",
      "permanent": false
    },
    {
      "source": "/forense",
      "destination": "/forensics",
      "permanent": false
    },
    {
      "source": "/imagem",
      "destination": "/image",
      "permanent": false
    },
    {
      "source": "/api/v1/:caminho*",
      "destination": "/api",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/solucoes",
      "destination": "/pages/index-solucoes"
    },
    {
      "source": "/image",
      "destination": "/pages/index-seleciona"
    },
    {
      "source": "/forensics",
      "destination": "/pages/index-forensics"
    },
    {
      "source": "/video",
      "destination": "/pages/index-video"
    },
    {
      "source": "/documentos",
      "destination": "/pages/index-documentos"
    },
    {
      "source": "/audio",
      "destination": "/pages/index-audio"
    },
    {
      "source": "/enviar",
      "destination": "/pages/index-enviar"
    },
    {
      "source": "/api",
      "destination": "/pages/index-api"
    },
    {
      "source": "/admin",
      "destination": "/pages/index-admin"
    },
    {
      "source": "/analise",
      "destination": "/pages/index-analise"
    },
    {
      "source": "/apresentacao",
      "destination": "/pages/index-apresentacao"
    },
    {
      "source": "/apoiadores",
      "destination": "/pages/index-apoiadores"
    },
    {
      "source": "/historico",
      "destination": "/pages/index-historico"
    },
    {
      "source": "/login",
      "destination": "/pages/index-login"
    },
    {
      "source": "/manutencao",
      "destination": "/pages/index-manutencao"
    },
    {
      "source": "/perfil",
      "destination": "/pages/index-perfil"
    },
    {
      "source": "/privacidade",
      "destination": "/pages/index-privacidade"
    },
    {
      "source": "/selecionar",
      "destination": "/pages/index-seleciona"
    },
    {
      "source": "/validador",
      "destination": "/pages/validador_tac_aida"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https://nwzijdudhemuibsyzpub.supabase.co https://aidaon-aida-api.hf.space https://aidaon-aida-video.hf.space; media-src 'self' data: blob:; connect-src 'self' https://nwzijdudhemuibsyzpub.supabase.co wss://nwzijdudhemuibsyzpub.supabase.co https://aidaon-aida-api.hf.space https://aidaon-aida-borda-api.hf.space https://aidaon-aida-video.hf.space; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(self), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src https://nwzijdudhemuibsyzpub.supabase.co; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/pages/index-admin(.html)?",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src https://nwzijdudhemuibsyzpub.supabase.co; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/scripts/(script-administrador|aida-admin-auth).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
