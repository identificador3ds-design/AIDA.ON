{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/forense",
      "destination": "/forensics",
      "permanent": false
    },
    {
      "source": "/imagem",
      "destination": "/image",
      "permanent": false
    },
    {
      "source": "/api/v1/:caminho*",
      "destination": "/api",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/solucoes",
      "destination": "/pages/index-solucoes.html"
    },
    {
      "source": "/image",
      "destination": "/pages/index-seleciona.html"
    },
    {
      "source": "/forensics",
      "destination": "/pages/index-forensics.html"
    },
    {
      "source": "/video",
      "destination": "/pages/index-video.html"
    },
    {
      "source": "/api",
      "destination": "/pages/index-api.html"
    },
    {
      "source": "/admin",
      "destination": "/pages/index-admin.html"
    },
    {
      "source": "/analise",
      "destination": "/pages/index-analise.html"
    },
    {
      "source": "/apresentacao",
      "destination": "/pages/index-apresentacao.html"
    },
    {
      "source": "/apoiadores",
      "destination": "/pages/index-apoiadores.html"
    },
    {
      "source": "/historico",
      "destination": "/pages/index-historico.html"
    },
    {
      "source": "/login",
      "destination": "/pages/index-login.html"
    },
    {
      "source": "/manutencao",
      "destination": "/pages/index-manutencao.html"
    },
    {
      "source": "/perfil",
      "destination": "/pages/index-perfil.html"
    },
    {
      "source": "/privacidade",
      "destination": "/pages/index-privacidade.html"
    },
    {
      "source": "/selecionar",
      "destination": "/pages/index-seleciona.html"
    },
    {
      "source": "/validador",
      "destination": "/pages/validador_tac_aida.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://nwzijdudhemuibsyzpub.supabase.co; connect-src 'self' https://nwzijdudhemuibsyzpub.supabase.co https://aidaon-aida-api.hf.space https://aidaon-aida-borda-api.hf.space; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
