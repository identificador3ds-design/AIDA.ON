# AIDA Core (camada 03). O Space no Hugging Face e o padrao.
AIDA_CORE_URL=https://aidaon-aida-api.hf.space
AIDA_CORE_TIMEOUT_S=180

# Autenticacao em producao: service role do Supabase (NUNCA a chave anon).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Somente desenvolvimento local. Deixe vazio em producao.
# AIDA_API_DEV_KEYS=aida_teste

# Limites de uso
AIDA_API_LIMITE=60
AIDA_API_JANELA_S=3600

# Orquestracao
AIDA_API_CONCORRENCIA=2
AIDA_API_ESPERA_FILA_S=30
AIDA_API_CACHE_TTL_S=900
AIDA_API_CACHE_MAX=128

# Borda
AIDA_API_MAX_MB=15
AIDA_API_CORS=*

# Logs
AIDA_API_LOG_CHAMADAS=true
AIDA_API_LOG_RETENCAO_DIAS=90
